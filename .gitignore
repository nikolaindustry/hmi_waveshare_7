# Build output
build/
managed_components/
dependencies.lock
sdkconfig
sdkconfig.old

# IDE / editor
.vscode/
.idea/
*.code-workspace

# Binaries
*.bin
*.elf
*.map

# Transcoded dashboards. Generated from a Hyperwisor export by
# tools/hds_transcode.py (see ./dashboard.sh) and flashed to the
# `storage` partition. Per-customer output, not source -- and the
# *.bin rule above would exclude its image blobs anyway, leaving a
# spec that references assets which are not there.
assets/dashboard/

# Logs & debug captures
*.log
*.txt
!CMakeLists.txt
!partitions.csv
!sdkconfig.defaults
cap.py
serial_log.ps1

# Python cache
__pycache__/
*.pyc

# ESP-IDF Installation Manager (eim) local config — machine-specific paths
eim_config.toml

# Desktop simulator build output (CMake/SDL)
sim/build/

# macOS Finder metadata
.DS_Store

# Distributable firmware images (rebuild with: idf.py merge-bin)
dist/*.bin
